+static QColor
+nodeErrorColor()
+{
+    KnobColor* k = dynamic_cast<KnobColor*>( appPTR->getCurrentSettings()->cachedKnob("nodeErrorColor").get() );
+    QColor c(217, 31, 26);
+    if (k) {
+        c.setRgbF( Image::clamp(k->getValue(0), 0., 1.), Image::clamp(k->getValue(1), 0., 1.), Image::clamp(k->getValue(2), 0., 1.) );
+    }
+
+    return c;
+}
