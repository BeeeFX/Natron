From 2cd80d36fac85c1844446d8823f09bb1a9d96695 Mon Sep 17 00:00:00 2001
From: "Baptiste G." <70719480+BeeeFX@users.noreply.github.com>
Date: Sat, 31 Oct 2026 13:27:20 +0000
Subject: [PATCH] Viewer: Shift+1 (the B side) no longer freezes Natron

InspectorNode::refreshActiveInputs held the viewer's _activeInputsMutex while it
turned the compare operation from None to Wipe (the B side set while an A input
is shown). Turning it on shows the B info bar, and with Qt 6 that can repaint the
viewer at once: ViewerGL::paintGL calls getActiveInputs, which waited for the same
non-recursive lock forever, and the window stopped responding. Reproduced on
Niik-l's own 2026.10.02 release (no patch, no layer): Shift+1 in the viewer with
an input connected. The operation is now changed once the lock is released (the
active inputs are already set, so the viewer draws the new B).

Core patch 0009 of the BeeeFX fork (layer/patches/). A fix of Niik-l's code, not a
look: no preference (nobody wants the freeze back).

Gap: none (a bug in Niik-l's 2.6, present since the Qt 6 port).
Size: 1 file, 12 lines added, 10 removed.
upstream: to offer now (Baptiste, 12 November 2026: the two fixes go to Niik-l from his
account).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Engine/NodeInputs.cpp | 22 ++++++++++++----------
 1 file changed, 12 insertions(+), 10 deletions(-)

diff --git a/Engine/NodeInputs.cpp b/Engine/NodeInputs.cpp
index 6baa55b4e..a1cedec68 100644
--- a/Engine/NodeInputs.cpp
+++ b/Engine/NodeInputs.cpp
@@ -1851,6 +1851,7 @@ InspectorNode::refreshActiveInputs(int inputNbChanged,
 {
     assert( QThread::currentThread() == qApp->thread() );
     NodePtr inputNode = getRealInput(inputNbChanged);
+    bool bInputSet = false;
     {
         QMutexLocker l(&_activeInputsMutex);
         if (!inputNode) {
@@ -1862,17 +1863,8 @@ InspectorNode::refreshActiveInputs(int inputNbChanged,
             }
         } else {
             if ( !isASide && (_activeInputs[0] != -1) ) {
-                ViewerInstance* isViewer = isEffectViewer();
-                if (isViewer) {
-                    OpenGLViewerI* viewerUI = isViewer->getUiContext();
-                    if (viewerUI) {
-                        ViewerCompositingOperatorEnum op = viewerUI->getCompositingOperator();
-                        if (op == eViewerCompositingOperatorNone) {
-                            viewerUI->setCompositingOperator(eViewerCompositingOperatorWipeUnder);
-                        }
-                    }
-                }
                 _activeInputs[1] = inputNbChanged;
+                bInputSet = true;
             } else {
                 _activeInputs[0] = inputNbChanged;
                 if (_activeInputs[1] == -1) {
@@ -1881,6 +1873,16 @@ InspectorNode::refreshActiveInputs(int inputNbChanged,
             }
         }
     }
+    // The viewer's compare operation is changed once the lock is released: changing it shows the B info bar, and
+    // with Qt 6 that can repaint the viewer at once, whose drawing reads the active inputs (getActiveInputs) and
+    // would wait for this same lock forever (the window froze on Shift+1 in the viewer, B side).
+    if (bInputSet) {
+        ViewerInstance* isViewer = isEffectViewer();
+        OpenGLViewerI* viewerUI = isViewer ? isViewer->getUiContext() : 0;
+        if ( viewerUI && (viewerUI->getCompositingOperator() == eViewerCompositingOperatorNone) ) {
+            viewerUI->setCompositingOperator(eViewerCompositingOperatorWipeUnder);
+        }
+    }
     Q_EMIT activeInputsChanged();
     Q_EMIT refreshOptionalState();
 }
