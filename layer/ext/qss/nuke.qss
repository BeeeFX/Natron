QMenuBar
{
    color: %5;
    background-color: %2;
}

QMenuBar::item
{
    color: %5;
    background-color: %2;
}

QMenuBar::item:selected
{
	color: %5;
    background: %1;
}

QPlainTextEdit {
    color: %5;
    background-color: %3;
    selection-color: %8;
    selection-background-color: %1;
}

QTextEdit[html],
QTextEdit[plainText],
QTextBrowser[html],
QTextBrowser[plainText] {
    color: %5;
}

OutputScriptTextEdit,
Natron--OutputScriptTextEdit,
Natron--OutputScriptTextEdit[plainText] {
    color: %5;
    background-color: %2;
    selection-color: %8;
    selection-background-color: %1;
}

/*
    Color Selector Button/Widget
*/

QToolButton#ColorSelectorButton {
    border: none;
}

QToolButton#ColorSelectorButton:menu-indicator {
    image: none;
}

QToolButton#ColorSelectorButton:pressed {
    padding-left: 0px;
    top: 0px;
    left: 0px;
}
/* ---- NATRON mainstyle.qss: end ---- */

/* ---- Nuke section ----
 * Nuke's interface, flat: square buttons with a thin dark edge, value fields darker than the panels they sit on,
 * thin scrollbars without arrows, tight menus with the orange highlight and dark text, flat tabs, icon buttons in
 * the viewer, playback and pane bars drawn without a frame until the mouse is over them. Our own rules, written
 * for this layer (nothing from Nuke). %1 selection (orange), %2 base (panels), %3 raised (buttons), %4 sunken
 * (fields, pane backgrounds), %5 text, %6 interpolated, %7 keyframe, %9 expression, %11 mouse over. "@layer/" is
 * the layer's folder: the skin writes this file for the session with it filled in (natron_layer/skin.py). The
 * nodes, the viewer's picture, the timeline and the curve editor are drawn by Natron itself and take their colours
 * from the preferences (ext/presets/nuke_look.toml), not from here.
 */

/* -- Panes, panels, frames -- */

TabWidget,
Natron--TabWidget {
    background-color: rgb(33, 33, 33);
}

NodeSettingsPanel[_selected="true"],
Natron--NodeSettingsPanel[_selected="true"] {
    border: 1px solid %1;
    border-radius: 0px;
}

NodeSettingsPanel[_selected="false"],
Natron--NodeSettingsPanel[_selected="false"] {
    border: 1px solid %4;
    border-radius: 0px;
}

QTabWidget::pane {
    border: 1px solid %4;
    margin-top: -1px;
}

QToolTip {
    color: %5;
    background-color: rgb(28, 28, 28);
    border: 1px solid rgb(90, 90, 90);
    border-radius: 0px;
    padding: 3px;
}

/* -- Tabs: Nuke's pane tabs (Foundry's guide pictures): on a dark strip, small tabs with rounded top corners and a
      dark edge, grey text; the current one lighter, standing a little higher, its name orange. -- */

QTabBar::tab {
    background: rgb(39, 39, 39);
    color: rgb(170, 170, 170);
    border: 1px solid rgb(20, 20, 20);
    border-bottom: 0px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    min-width: 0px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin: 2px 1px 0px 0px;
}

QTabBar::tab:selected {
    background: %2;
    border-top: 1px solid rgb(77, 77, 77);
    color: %1;
    margin-top: 0px;
    padding-bottom: 3px;
}

QTabBar::tab:hover:!selected {
    background: rgb(56, 56, 56);
}

QTabBar::close-button {
    image: url(@layer/ext/icons/qss/close_tab.png);
    subcontrol-position: right;
}

QTabBar::close-button:hover {
    image: url(@layer/ext/icons/qss/close_tab_hover.png);
}

/* The properties panel's own tabs (Controls, Node, Info): flat and close together. */
QTabBar::tab#DockablePanelTabWidget,
QTabBar::tab#Natron--DockablePanelTabWidget {
    min-width: 0px;
    padding-left: 12px;
    padding-right: 12px;
}

/* -- Splitters: thin and flat -- */

QSplitter::handle:horizontal,
QSplitter::handle:vertical {
    background-color: rgb(24, 24, 24);
    border: 0px;
}

QSplitter::handle::horizontal {
    width: 3px;
}

QSplitter::handle::vertical {
    height: 3px;
}

/* -- Buttons: square, a thin dark edge, lighter under the mouse -- */

QPushButton {
    background-color: %3;
    color: %5;
    border: 1px solid rgb(22, 22, 22);
    border-radius: 1px;
    padding: 2px 6px;
}

QPushButton:hover {
    background-color: rgb(92, 92, 92);
    border: 1px solid rgb(22, 22, 22);
}

QPushButton:pressed,
QPushButton:checked {
    background-color: rgb(38, 38, 38);
}

QPushButton:focus {
    border: 1px solid rgb(22, 22, 22);
}

QPushButton:!enabled {
    color: rgb(110, 110, 110);
}

/* Icon buttons in the viewer's bars, the playback bar and the pane headers: no frame until the mouse is over. */
ViewerTab QPushButton,
Natron--ViewerTab QPushButton,
TabWidget QPushButton,
Natron--TabWidget QPushButton,
QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 1px;
    padding: 0px;
}

ViewerTab QPushButton:hover,
Natron--ViewerTab QPushButton:hover,
TabWidget QPushButton:hover,
Natron--TabWidget QPushButton:hover,
QToolBar QToolButton:hover {
    background-color: rgb(80, 80, 80);
    border: 1px solid rgb(30, 30, 30);
}

ViewerTab QPushButton:pressed,
Natron--ViewerTab QPushButton:pressed,
ViewerTab QPushButton:checked,
Natron--ViewerTab QPushButton:checked,
TabWidget QPushButton:pressed,
Natron--TabWidget QPushButton:pressed,
QToolBar QToolButton:pressed {
    background-color: rgb(30, 30, 30);
    border: 1px solid rgb(30, 30, 30);
}

/* The properties panels (inside a pane) keep raised text buttons ("Normalize", "Add...") like Nuke's knobs. */
NodeSettingsPanel QPushButton,
Natron--NodeSettingsPanel QPushButton,
DockablePanel QPushButton,
Natron--DockablePanel QPushButton {
    background-color: %3;
    border: 1px solid rgb(22, 22, 22);
    border-radius: 1px;
    padding: 1px 5px;
}

NodeSettingsPanel QPushButton:hover,
Natron--NodeSettingsPanel QPushButton:hover,
DockablePanel QPushButton:hover,
Natron--DockablePanel QPushButton:hover {
    background-color: rgb(92, 92, 92);
}

NodeSettingsPanel QPushButton:checked,
Natron--NodeSettingsPanel QPushButton:checked,
NodeSettingsPanel QPushButton:pressed,
Natron--NodeSettingsPanel QPushButton:pressed,
DockablePanel QPushButton:checked,
Natron--DockablePanel QPushButton:checked,
DockablePanel QPushButton:pressed,
Natron--DockablePanel QPushButton:pressed {
    background-color: rgb(38, 38, 38);
}

QToolButton {
    background-color: %2;
    color: %5;
    border: 0px;
}

QToolButton:pressed,
QToolButton:focus {
    border: 0px;
}

QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

ViewerToolButton[isSelected="true"],
Natron--ViewerToolButton[isSelected="true"] {
    border: 1px solid %1;
    background-color: rgb(30, 30, 30);
}

/* -- The left toolbar: Nuke's column of node menus, each grey icon on its own small dark tile -- */

QToolBar {
    background-color: %2;
    spacing: 2px;
    padding: 3px 2px;
    border: 0px;
    border-right: 1px solid rgb(24, 24, 24);
}

QToolBar QToolButton {
    background-color: rgb(44, 44, 44);
    border: 1px solid rgb(22, 22, 22);
    border-radius: 2px;
    min-width: 28px;
    min-height: 28px;
    padding: 1px;
}

QToolBar QToolButton:hover {
    background-color: rgb(74, 74, 74);
    border: 1px solid rgb(22, 22, 22);
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background-color: rgb(28, 28, 28);
    border: 1px solid %1;
}

/* -- Value fields: darker than the panel, square, a thin dark edge, orange when typing -- */

QLineEdit,
SpinBox[animation="0"],
Natron--SpinBox[animation="0"],
LineEdit[animation="0"],
Natron--LineEdit[animation="0"] {
    background-color: %4;
}

QLineEdit {
    border: 1px solid rgb(18, 18, 18);
    border-radius: 0px;
    padding: 1px 3px;
    selection-color: rgb(20, 20, 20);
    selection-background-color: %1;
}

QLineEdit:focus {
    border: 1px solid %1;
    border-radius: 0px;
}

QLineEdit:!enabled,
QLineEdit:read-only {
    color: rgb(120, 120, 120);
    background-color: rgb(40, 40, 40);
}

SpinBox[animation="3"],
Natron--SpinBox[animation="3"] {
    color: rgb(20, 20, 20);
}

QTextEdit,
QPlainTextEdit {
    background-color: %4;
    border: 1px solid rgb(18, 18, 18);
    selection-color: rgb(20, 20, 20);
    selection-background-color: %1;
}

QTextEdit:focus {
    border: 1px solid %1;
}

/* -- Drop-down menus (choices) -- */

ComboBox,
Natron--ComboBox {
    border-radius: 0px;
    border: 1px solid rgb(22, 22, 22);
}

QComboBox {
    background-color: %3;
    border: 1px solid rgb(22, 22, 22);
    border-radius: 1px;
    padding: 1px 18px 1px 5px;
    selection-color: rgb(20, 20, 20);
    selection-background-color: %1;
}

QComboBox:hover {
    background-color: rgb(92, 92, 92);
}

QComboBox::drop-down {
    border: 0px;
    width: 16px;
}

QComboBox::down-arrow {
    image: url(@layer/ext/icons/qss/arrow_down.png);
    width: 9px;
    height: 9px;
}

QComboBox QAbstractItemView {
    background-color: %2;
    border: 1px solid rgb(90, 90, 90);
    selection-color: rgb(20, 20, 20);
    selection-background-color: %1;
}

/* -- Check boxes: a small dark square with a grey tick -- */

QCheckBox::indicator {
    width: 12px;
    height: 12px;
}

QCheckBox::indicator:unchecked,
QCheckBox::indicator:unchecked:hover,
QCheckBox::indicator:unchecked:focus {
    image: none;
    background-color: %4;
    border: 1px solid rgb(18, 18, 18);
}

QCheckBox::indicator:unchecked:hover {
    border: 1px solid rgb(110, 110, 110);
}

QCheckBox::indicator:checked,
QCheckBox::indicator:checked:focus {
    image: url(@layer/ext/icons/qss/check.png);
    background-color: %4;
    border: 1px solid rgb(18, 18, 18);
}

QCheckBox::indicator:checked:hover {
    image: url(@layer/ext/icons/qss/check_hover.png);
    background-color: %4;
    border: 1px solid rgb(110, 110, 110);
}

/* -- Group boxes -- */

QGroupBox::indicator:unchecked {
    image: url(@layer/ext/icons/qss/arrow_right.png);
}

QGroupBox::indicator:checked {
    image: url(@layer/ext/icons/qss/arrow_down.png);
}

/* -- Scrollbars: thin, flat, no arrows -- */

QScrollBar:vertical {
    border: 0px;
    background: %4;
    width: 10px;
    margin: 0px;
}

QScrollBar:horizontal {
    border: 0px;
    background: %4;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    image: none;
    background: rgb(88, 88, 88);
    border: 0px;
    border-radius: 0px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    min-height: 24px;
}

QScrollBar::handle:horizontal {
    min-width: 24px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: rgb(125, 125, 125);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: 0px;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical,
QScrollBar::left-arrow:horizontal,
QScrollBar::right-arrow:horizontal {
    image: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* -- Lists, trees, table headers -- */

QTreeView,
QListView,
QTableView {
    background-color: %4;
    alternate-background-color: rgb(40, 40, 40);
    selection-color: rgb(20, 20, 20);
    selection-background-color: %1;
    border: 1px solid rgb(18, 18, 18);
}

QHeaderView::section,
QHeaderView:section {
    background-color: %3;
    color: %5;
    border: 0px;
    border-right: 1px solid rgb(22, 22, 22);
    border-bottom: 1px solid rgb(22, 22, 22);
    padding: 2px 5px;
}

/* -- Menus: tight rows, orange under the mouse with dark text -- */

QMenuBar {
    background-color: %2;
    border-bottom: 1px solid rgb(24, 24, 24);
}

QMenuBar::item {
    background-color: transparent;
    padding: 3px 8px;
}

QMenuBar::item:selected {
    background: %1;
    color: rgb(20, 20, 20);
}

QMenu {
    background-color: %2;
    border: 1px solid rgb(90, 90, 90);
    padding: 2px 0px 2px 0px;
}

QMenu::item {
    background-color: transparent;
    padding: 3px 26px 3px 24px;
}

QMenu::item:selected {
    background-color: %1;
    color: rgb(20, 20, 20);
}

QMenu::item:!enabled {
    color: rgb(115, 115, 115);
}

QMenu::separator {
    height: 1px;
    background: rgb(70, 70, 70);
    margin: 3px 6px;
}

QMenu::icon {
    padding-left: 4px;
}

QMenu::right-arrow {
    image: url(@layer/ext/icons/qss/arrow_right.png);
    width: 9px;
    height: 9px;
    padding-right: 6px;
}

/* -- Dialogs, and Tab's node search -- */

QDialog {
    background-color: %2;
}

QDialogButtonBox {
    background-color: %2;
}

NodeCreationDialog,
Natron--NodeCreationDialog {
    background-color: %2;
    border: 1px solid %1;
    border-radius: 0px;
}

QMessageBox {
    background-color: %2;
}

/* -- Properties panel header (this fork's builds name it, core patch 0001): small flat buttons as Nuke's
      header, a frame only under the mouse; the panel's own knob buttons above stay raised. -- */

QFrame#DockablePanelHeader {
    border: 0px;
    border-bottom: 1px solid rgb(24, 24, 24);
    background-color: %2;
}

QFrame#DockablePanelHeader QPushButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
    padding: 0px;
}

QFrame#DockablePanelHeader QPushButton:hover {
    background-color: rgb(70, 70, 70);
    border: 1px solid rgb(24, 24, 24);
}

QFrame#DockablePanelHeader QPushButton:pressed,
QFrame#DockablePanelHeader QPushButton:checked {
    background-color: rgb(34, 34, 34);
    border: 1px solid rgb(24, 24, 24);
}

QFrame#DockablePanelHeader QLineEdit {
    background-color: rgb(30, 30, 30);
    border: 1px solid rgb(18, 18, 18);
    padding: 1px 4px;
}

/* -- Tab's node search, Nuke's way: a compact dark box, the typed text large, matches in a tight list with the
      orange highlight. (Natron names the dialog nodeCreationDialog.) -- */

QDialog#nodeCreationDialog,
NodeCreationDialog#nodeCreationDialog,
Natron--NodeCreationDialog#nodeCreationDialog {
    background-color: rgb(40, 40, 40);
    border: 1px solid rgb(14, 14, 14);
    padding: 3px;
}

#nodeCreationDialog QLineEdit {
    background-color: rgb(30, 30, 30);
    color: rgb(236, 236, 236);
    border: 1px solid rgb(205, 205, 205);
    border-radius: 3px;
    padding: 2px 5px;
    min-height: 16px;
}

#nodeCreationDialog QListView,
QListView#nodeCreationDialogList {
    background-color: rgb(40, 40, 40);
    alternate-background-color: rgb(40, 40, 40);
    border: 1px solid rgb(14, 14, 14);
    outline: 0px;
    padding: 0px;
}

#nodeCreationDialog QListView::item,
QListView#nodeCreationDialogList::item {
    padding: 0px 6px;
    border: 0px;
}

#nodeCreationDialog QListView::item:selected,
#nodeCreationDialog QListView::item:hover,
QListView#nodeCreationDialogList::item:selected,
QListView#nodeCreationDialogList::item:hover {
    background-color: %1;
    color: rgb(20, 20, 20);
}

/* -- The viewer's bars, arranged in Nuke's order by natron_layer/arrange.py, which names them: flat rows with thin
      dark separators between the groups of controls (Foundry's "Using the Viewer Controls" pictures). -- */

QWidget#SngViewerBar1,
QWidget#SngViewerBar2 {
    background-color: %2;
}

QFrame#SngViewerSeparator {
    background-color: rgb(26, 26, 26);
    border: 0px;
    margin: 3px 0px;
}

QWidget#SngViewerBar1 QLabel,
QWidget#SngViewerBar2 QLabel {
    font-weight: bold;
    padding: 0px 2px 0px 4px;
}

/* The playback bar: Nuke draws its buttons as small raised boxes side by side, the current frame in orange. */
QWidget#SngPlayerBar QPushButton {
    background-color: rgb(66, 66, 66);
    border: 1px solid rgb(22, 22, 22);
    border-radius: 2px;
    margin: 0px 1px;
}

QWidget#SngPlayerBar QPushButton:hover {
    background-color: rgb(88, 88, 88);
}

#SngCurrentFrame {
    color: %1;
}

QWidget#SngPlayerBar QPushButton:pressed,
QWidget#SngPlayerBar QPushButton:checked {
    background-color: rgb(30, 30, 30);
    border: 1px solid rgb(22, 22, 22);
}

/* -- The properties panels' rows (core patch 0004, this fork's builds): the animation button at the end of a value's
      row, flat until the mouse is over it, as Nuke's. -- */

QPushButton#KnobAnimationButton {
    background-color: transparent;
    border: 1px solid rgb(30, 30, 30);
    border-radius: 2px;
    padding: 0px;
}

QPushButton#KnobAnimationButton:hover {
    background-color: rgb(80, 80, 80);
}

/* The viewer bar's flat drop-downs (arrange.py sets their "flat" property): no edge either. */
ComboBox[flat="true"],
Natron--ComboBox[flat="true"] {
    border: 0px;
}

/* -- Round 4 (.sng5): the timeline and the properties panels' widgets, measured on Foundry's guide pictures ("Using
      the Viewer Controls", the timeline picture; "Using the Color Controls", a knob row): panels 50; fields a little
      lighter than the panel (55 to 58) with a dark edge (30); buttons raised, a light-to-dark grey from top to
      bottom (82 to 67) with a dark edge; the playback in and out points as tall rounded boxes at the ruler's ends,
      their numbers dim. -- */

/* The playback bar's buttons: small raised boxes, a little wider than tall (arrange.py sizes them). */
QWidget#SngPlayerBar QPushButton {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(80, 80, 80), stop: 1 rgb(68, 68, 68));
    border: 1px solid rgb(30, 30, 30);
    border-radius: 3px;
    margin: 0px 1px;
    padding: 0px;
}

QWidget#SngPlayerBar QPushButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(98, 98, 98), stop: 1 rgb(84, 84, 84));
}

QWidget#SngPlayerBar QPushButton:pressed,
QWidget#SngPlayerBar QPushButton:checked {
    background-color: rgb(34, 34, 34);
    border: 1px solid rgb(30, 30, 30);
}

/* The bar's fields (frame rate, increment): Nuke's fields, a little lighter than the bar, a dark edge. */
QWidget#SngPlayerBar QLineEdit {
    background-color: rgb(58, 58, 58);
    border: 1px solid rgb(30, 30, 30);
    border-radius: 2px;
}

/* The current frame: an orange number in a flat field. */
QLineEdit#SngCurrentFrame,
#SngCurrentFrame {
    color: %1;
    background-color: rgb(58, 58, 58);
    border: 0px;
    border-radius: 2px;
}

/* The playback in and out points at the frame ruler's ends: tall flat boxes, the number dim and a little larger. */
QLineEdit#SngInPoint,
QLineEdit#SngOutPoint {
    background-color: rgb(58, 58, 58);
    color: rgb(150, 150, 150);
    border: 0px;
    border-radius: 3px;
    font-size: 10pt;
    padding: 0px;
}

QLineEdit#SngInPoint:focus,
QLineEdit#SngOutPoint:focus {
    border: 1px solid %1;
}

/* Properties panels: the value fields a little lighter than the panel with a dark edge (an animated or keyed value
   keeps Natron's tint). */
NodeSettingsPanel QLineEdit,
Natron--NodeSettingsPanel QLineEdit {
    border: 1px solid rgb(30, 30, 30);
    border-top: 1px solid rgb(22, 22, 22);
    border-radius: 2px;
    padding: 0px 3px;
}

NodeSettingsPanel SpinBox[animation="0"],
Natron--NodeSettingsPanel Natron--SpinBox[animation="0"],
NodeSettingsPanel LineEdit[animation="0"],
Natron--NodeSettingsPanel Natron--LineEdit[animation="0"] {
    background-color: rgb(55, 55, 55);
}

NodeSettingsPanel QLineEdit:focus,
Natron--NodeSettingsPanel QLineEdit:focus {
    border: 1px solid %1;
}

/* Properties panels: buttons ("4", the colour wheel, Normalize, the animation button) raised, light to dark. */
NodeSettingsPanel QPushButton,
Natron--NodeSettingsPanel QPushButton,
NodeSettingsPanel QToolButton#ColorSelectorButton,
Natron--NodeSettingsPanel QToolButton#ColorSelectorButton,
QPushButton#KnobAnimationButton {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(82, 82, 82), stop: 1 rgb(67, 67, 67));
    border: 1px solid rgb(30, 30, 30);
    border-radius: 2px;
}

NodeSettingsPanel QPushButton:hover,
Natron--NodeSettingsPanel QPushButton:hover,
NodeSettingsPanel QToolButton#ColorSelectorButton:hover,
Natron--NodeSettingsPanel QToolButton#ColorSelectorButton:hover,
QPushButton#KnobAnimationButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(100, 100, 100), stop: 1 rgb(84, 84, 84));
}

NodeSettingsPanel QPushButton:checked,
Natron--NodeSettingsPanel QPushButton:checked,
NodeSettingsPanel QPushButton:pressed,
Natron--NodeSettingsPanel QPushButton:pressed {
    background-color: rgb(36, 36, 36);
}

/* The header keeps its small flat buttons (Nuke's header), after the rule above. */
QFrame#DockablePanelHeader QPushButton {
    background-color: transparent;
    border: 1px solid transparent;
}

QFrame#DockablePanelHeader QPushButton:hover {
    background-color: rgb(70, 70, 70);
    border: 1px solid rgb(24, 24, 24);
}

QFrame#DockablePanelHeader QLineEdit {
    background-color: rgb(55, 55, 55);
    border: 1px solid rgb(30, 30, 30);
    border-radius: 2px;
}

/* A node panel's own tabs (Grade, Node, Info): the current one white and bold on the panel's grey, the others grey
   on a darker tab, as Nuke's (no orange: that is for the panes' tabs). */
QTabBar#DockablePanelTabWidget::tab {
    color: rgb(165, 165, 165);
    font-weight: bold;
}

QTabBar#DockablePanelTabWidget::tab:selected {
    color: rgb(232, 232, 232);
}

/* -- Round 6 (.sng9): Nuke's sizes and its buttons, measured on Foundry's guide pictures at a known scale (Verdana
      11 px, capitals 8 px high, is the yardstick: "Setting Preferences" preferences.png at 1x, "Using the Viewer
      Controls" layers.png at 1x and comp_timeline.png at 2.75x, "Properties Panels" node_properties.png at 3x,
      "Output (Write) Nodes" render_views1.png at 1x): push buttons 22 to 24 pixels high, a one-pixel near-black
      edge, rounded 2 pixels, filled light to dark (82 on the top row, 78 to 70 down, 67 on the bottom row); value
      fields 19 high; check boxes 13; menu rows 20 with an orange highlight shaded top to bottom; pane tab strips 20;
      the viewer's bars 26; the playback buttons flat boxes about 30 x 24. The later rules win over the earlier
      rounds' above. -- */

/* Push buttons everywhere: Nuke's raised button. */
QPushButton {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(82, 82, 82), stop: 0.08 rgb(78, 78, 78),
                                      stop: 0.92 rgb(70, 70, 70), stop: 1 rgb(67, 67, 67));
    color: %5;
    border: 1px solid rgb(15, 15, 15);
    border-radius: 2px;
    padding: 2px 8px;
    min-height: 16px;
}

QPushButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(98, 98, 98), stop: 0.08 rgb(93, 93, 93),
                                      stop: 0.92 rgb(84, 84, 84), stop: 1 rgb(80, 80, 80));
    border: 1px solid rgb(15, 15, 15);
}

QPushButton:pressed {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(36, 36, 36), stop: 1 rgb(46, 46, 46));
    border: 1px solid rgb(15, 15, 15);
}

/* A switched-on text button: sunken, its name in the selection orange (Nuke's toggles light up orange). */
QPushButton:checked {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(40, 40, 40), stop: 1 rgb(50, 50, 50));
    color: %1;
    border: 1px solid rgb(15, 15, 15);
}

QPushButton:!enabled {
    background-color: rgb(58, 58, 58);
    color: rgb(105, 105, 105);
    border: 1px solid rgb(36, 36, 36);
}

QPushButton:focus {
    border: 1px solid rgb(15, 15, 15);
}

/* Dialog buttons (OK, Cancel): Nuke's are 24 high and at least 75 wide. */
QDialogButtonBox QPushButton,
QMessageBox QPushButton {
    min-height: 18px;
    min-width: 57px;
    padding: 2px 8px;
}

/* Icon buttons in the viewer's bars and the pane headers stay frameless until the mouse is over them. */
ViewerTab QPushButton,
Natron--ViewerTab QPushButton,
TabWidget QPushButton,
Natron--TabWidget QPushButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 0px;
    min-height: 0px;
}

ViewerTab QPushButton:hover,
Natron--ViewerTab QPushButton:hover,
TabWidget QPushButton:hover,
Natron--TabWidget QPushButton:hover {
    background-color: rgb(80, 80, 80);
    border: 1px solid rgb(30, 30, 30);
}

ViewerTab QPushButton:pressed,
Natron--ViewerTab QPushButton:pressed,
ViewerTab QPushButton:checked,
Natron--ViewerTab QPushButton:checked,
TabWidget QPushButton:pressed,
Natron--TabWidget QPushButton:pressed {
    background-color: rgb(30, 30, 30);
    border: 1px solid rgb(30, 30, 30);
    color: %5;
}

/* Properties panels: the same buttons, 20 high ("Render", "Normalize", the "4" and the animation buttons; Natron
   makes them 22). These come after the icon buttons' rule: a panel sits in a pane (TabWidget). */
NodeSettingsPanel QPushButton,
Natron--NodeSettingsPanel QPushButton,
DockablePanel QPushButton,
Natron--DockablePanel QPushButton {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(82, 82, 82), stop: 0.08 rgb(78, 78, 78),
                                      stop: 0.92 rgb(70, 70, 70), stop: 1 rgb(67, 67, 67));
    border: 1px solid rgb(30, 30, 30);
    border-radius: 2px;
    padding: 1px 6px;
    min-height: 16px;
    max-height: 16px;
}

NodeSettingsPanel QPushButton:hover,
Natron--NodeSettingsPanel QPushButton:hover,
DockablePanel QPushButton:hover,
Natron--DockablePanel QPushButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(98, 98, 98), stop: 1 rgb(80, 80, 80));
}

NodeSettingsPanel QPushButton:pressed,
Natron--NodeSettingsPanel QPushButton:pressed,
DockablePanel QPushButton:pressed,
Natron--DockablePanel QPushButton:pressed {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(36, 36, 36), stop: 1 rgb(46, 46, 46));
}

NodeSettingsPanel QPushButton:checked,
Natron--NodeSettingsPanel QPushButton:checked,
DockablePanel QPushButton:checked,
Natron--DockablePanel QPushButton:checked {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(40, 40, 40), stop: 1 rgb(50, 50, 50));
}

/* Properties panels: value fields and drop-downs 19 high, as Nuke's knob rows (Natron makes them 22; a stylesheet's
   height is the inside, without the one-pixel edges). */
NodeSettingsPanel LineEdit,
Natron--NodeSettingsPanel Natron--LineEdit,
NodeSettingsPanel SpinBox,
Natron--NodeSettingsPanel Natron--SpinBox,
NodeSettingsPanel ComboBox,
Natron--NodeSettingsPanel Natron--ComboBox {
    min-height: 17px;
    max-height: 17px;
}

/* The rest of a knob row 19 high too: the slider, the colour swatch and the colour wheel button (Natron: 22). */
NodeSettingsPanel ScaleSliderQWidget,
Natron--NodeSettingsPanel Natron--ScaleSliderQWidget,
NodeSettingsPanel ColorPickerLabel,
Natron--NodeSettingsPanel Natron--ColorPickerLabel {
    min-height: 19px;
    max-height: 19px;
}

NodeSettingsPanel ColorPickerLabel,
Natron--NodeSettingsPanel Natron--ColorPickerLabel {
    min-width: 19px;
    max-width: 19px;
}

NodeSettingsPanel QToolButton#ColorSelectorButton,
Natron--NodeSettingsPanel QToolButton#ColorSelectorButton {
    min-height: 17px;
    max-height: 17px;
    min-width: 17px;
    max-width: 17px;
}

/* The header keeps its small flat buttons (Nuke's header), after the rules above. */
QFrame#DockablePanelHeader QPushButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 0px;
    min-height: 0px;
    max-height: 1000px;
}

QFrame#DockablePanelHeader QPushButton:hover {
    background-color: rgb(70, 70, 70);
    border: 1px solid rgb(24, 24, 24);
}

QFrame#DockablePanelHeader QPushButton:pressed,
QFrame#DockablePanelHeader QPushButton:checked {
    background-color: rgb(34, 34, 34);
    border: 1px solid rgb(24, 24, 24);
}

/* The playback bar: Nuke's flat grey boxes (70) side by side with a near-black edge, rounded 2 pixels; the frame
   step and key buttons a shade darker (61), as on Foundry's timeline picture. arrange.py sizes them 30 x 24. */
QWidget#SngPlayerBar QPushButton {
    background-color: rgb(70, 70, 70);
    border: 1px solid rgb(35, 31, 32);
    border-radius: 2px;
    margin: 0px;
    padding: 0px;
}

QWidget#SngPlayerBar QPushButton:hover {
    background-color: rgb(88, 88, 88);
}

QWidget#SngPlayerBar QPushButton:pressed,
QWidget#SngPlayerBar QPushButton:checked {
    background-color: rgb(36, 36, 36);
    border: 1px solid rgb(35, 31, 32);
}

QWidget#SngPlayerBar QLineEdit,
QLineEdit#SngCurrentFrame,
#SngCurrentFrame {
    background-color: rgb(58, 58, 58);
    border: 0px;
    border-radius: 2px;
}

#SngCurrentFrame {
    color: %1;
}

/* Pane tabs: Nuke's strip is 20 high. */
QTabBar::tab {
    padding-top: 1px;
    padding-bottom: 1px;
}

QTabBar::tab:selected {
    padding-bottom: 2px;
}

/* Menus: rows 20 high, the highlight Nuke's orange shaded from its light top (253, 152, 34) to (232, 139, 29). */
QMenu::item {
    padding: 4px 26px 3px 24px;
}

QMenu::item:selected,
QMenuBar::item:selected {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(253, 152, 34), stop: 1 rgb(232, 139, 29));
    color: rgb(20, 20, 20);
}

/* Menus: a near-black edge (28), as Nuke's (layers.png), not the earlier rounds' light grey one. */
QMenu {
    border: 1px solid rgb(28, 28, 28);
}

/* Check boxes: 13 pixels, as Nuke's. */
QCheckBox::indicator {
    width: 11px;
    height: 11px;
}
